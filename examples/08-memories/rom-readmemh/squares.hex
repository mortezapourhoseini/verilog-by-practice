// squares.hex - contents of the 16 x 8-bit ROM: address k holds k*k.
// One hex value per line. Lines starting with // are comments.
// "@0" sets the address where the next value goes (optional here).
@0
00   //  0 *  0 =   0
01   //  1 *  1 =   1
04   //  2 *  2 =   4
09   //  3 *  3 =   9
10   //  4 *  4 =  16
19   //  5 *  5 =  25
24   //  6 *  6 =  36
31   //  7 *  7 =  49
40   //  8 *  8 =  64
51   //  9 *  9 =  81
64   // 10 * 10 = 100
79   // 11 * 11 = 121
90   // 12 * 12 = 144
a9   // 13 * 13 = 169
c4   // 14 * 14 = 196
e1   // 15 * 15 = 225
